# Server Configuration
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=blogdb
DB_PORT=3306

# Secret Key for JWT Authentication
SECRET_KEY=your_secret_key_here

# Frontend URL (used for CORS and password-reset links)
CLIENT_URL=http://localhost:3000

# SMTP settings for password-reset emails
# Leave SMTP_HOST empty to print reset links to the server console instead.
# To email them from a Gmail account (they can be sent to any address):
#   1. turn on 2-Step Verification for the Google account
#   2. create an App Password at https://myaccount.google.com/apppasswords
#   3. fill in the values below, for example:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USER=your-address@gmail.com
#        SMTP_PASS=abcd efgh ijkl mnop
#        MAIL_FROM="BlogSpace <your-address@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
